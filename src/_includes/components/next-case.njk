<a href="{{ nextProject.href }}" {% if nextProject.external %}target="_blank" rel="noopener"{% endif %} class="case-footer-next">
      <p class="case-footer-next-label">Next case</p>
      <div class="case-next-row">
        <div class="case-next-thumb">
          <img src="{{ nextProject.cover }}" alt="{{ nextProject.title }}" loading="lazy">
        </div>
        <div class="case-next-info">
          <h3>{{ nextProject.title }}</h3>
          <p class="case-next-type">{{ nextProject.badges | join(" / ") }}</p>
          <span class="case-next-link">
            {% if nextProject.external %}View on Behance{% else %}View case{% endif %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
          </span>
        </div>
        <svg class="case-next-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg>
      </div>
    </a>
