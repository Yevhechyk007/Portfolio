<a class="project-card {{ project.cardClass }}" href="{{ project.href }}" {% if project.external %}target="_blank" rel="noopener"{% endif %}>
  <div class="project-cover">{% if project.coverWebp %}<picture><source srcset="{{ project.coverWebp }}" type="image/webp">{% endif %}<img src="{{ project.cover }}" alt="{{ project.title }}" loading="lazy">{% if project.coverWebp %}</picture>{% endif %}<div class="project-tags" aria-hidden="true">{% for pill in project.pills %}<span class="project-tag-pill">{{ pill | safe }}</span>{% endfor %}</div></div>
  <div class="project-info"><h3>{{ project.title }}</h3><div class="project-badges">{% for badge in project.badges %}<span class="project-badge">{{ badge | safe }}</span>{% endfor %}</div><p class="project-desc">{{ project.summary | safe }}</p><span class="view-behance">{% if project.external %}View on Behance{% else %}View case{% endif %} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg></span></div>
</a>
