<main class="category-page active" id="cat-{{ category }}">
<a class="back-btn" href="/#projects"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M5 12L12 19M5 12L12 5"/></svg> Back to Projects</a>
<h1 class="category-page-title">{{ heading }}</h1>
<div class="category-projects-grid">
{% for entry in collections.projects %}{% if entry.data.project.category == category %}{% set project = entry.data.project %}{% include "components/project-card.njk" %}{% endif %}{% endfor %}
</div>
{{ content | safe }}
</main>